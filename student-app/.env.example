# Firebase web config - copy to .env.local and fill in.
# Use the same Firebase project as teacher-app and admin-panel.
# Values come from Firebase console -> Project settings -> Your apps -> Web app.
# These are PUBLIC by design: they only identify the project. Data is protected
# by Firebase Auth and the API's server-side checks, never by hiding these.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# API origin. Leave blank during development: Vite proxies /api to :4000.
# Production build example:
# VITE_API_URL=https://xchool-api.srikarsensai.workers.dev
VITE_API_URL=

# Optional one-click demo student. The shortcut only appears when BOTH are set.
# Leave blank for a normal school deployment.
VITE_STUDENT_DEMO_EMAIL=
VITE_STUDENT_DEMO_PASSWORD=
