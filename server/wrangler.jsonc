{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "xchool-api",
  "main": "./src/worker.js",
  "compatibility_date": "2026-08-04",
  "compatibility_flags": ["nodejs_compat"],
  "alias": {
    "iconv-lite": "./src/iconv-lite-stub.js",
    "firebase-admin/app": "./src/workers/firebase-app-stub.js",
    "firebase-admin/auth": "./src/workers/firebase-auth-stub.js"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "xchool-db",
      "database_id": "54b2bef7-12df-406f-8f78-201135ab3760"
    }
  ],
  "vars": {
    "PORT": "4000",
    "RUNTIME": "workers",
    "DATA_BACKEND": "d1",
    "DISABLE_FILE_CACHE": "true",
    "FIREBASE_PROJECT_ID": "thiangle-349e7"
  },
  "observability": {
    "enabled": true
  }
}
